# Налаштування бази даних / Database settings
DB_HOST=localhost
DB_USER=camsboard_user
DB_PASS=
DB_NAME=camsboard


# Режим роботи / Application environment: development | production
APP_ENV=production

# Google reCAPTCHA Enterprise (опціонально / optional)
# Поставте false, якщо не використовуєте рекапчу / Set to false to disable reCAPTCHA
RECAPTCHA_ENABLED=false
GOOGLE_APPLICATION_CREDENTIALS="/var/www/camsboard/config/google-credentials.json"
GOOGLE_PROJECT_ID=
RECAPTCHA_SITE_KEY=

# Двофакторна автентифікація через Email / Telegram (опціонально / optional)
# Поставте false для першого входу за логіном 1234567891 та динамічним паролем 1111, після налаштування сповіщень змініть на true
# Set to false for initial login with ID 1234567891 and dynamic code 1111, change to true after configuring notifications
AUTH_2FA_ENABLED=false

